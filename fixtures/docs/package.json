{
	"name": "@mikode13/ci-docs-fixture",
	"version": "0.0.0",
	"private": true,
	"description": "Contract fixture for the MiKode documentation CI profile.",
	"license": "SEE LICENSE IN ../../LICENSE",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"format:check": "prettier . --check",
		"lint:markdown": "markdownlint-cli2 README.md \"guides/**/*.md\"",
		"links:internal": "remark --quiet --frail --use remark-validate-links .",
		"docs:check": "pnpm run format:check && pnpm run lint:markdown && pnpm run links:internal"
	},
	"devDependencies": {
		"@mikode13/code-style": "0.1.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"remark-cli": "12.0.1",
		"remark-validate-links": "13.1.0"
	}
}
